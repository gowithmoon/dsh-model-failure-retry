{
  "name": "dsh-model-failure-retry",
  "version": "0.1.0",
  "description": "DSH plugin: retry or fall back when a model request fails on rate limit, transient failure, or quota exhaustion.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "llm",
    "retry",
    "fallback",
    "rate-limit"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "src",
    "locale",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "dsh": {
    "engines": {
      "dsh": ">=0.2.2-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/schemastery": "3.19.0",
    "esbuild": "0.28.2",
    "react": "18.3.1",
    "vitest": "4.1.5"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "node scripts/build-client.mjs",
    "pretest": "npm run build",
    "prepare": "npm run build"
  }
}
